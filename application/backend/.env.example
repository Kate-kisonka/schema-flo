PORT=3001
NODE_ENV=development

# база данных:
DATABASE_URL=postgresql://schema_flo:schema_flo@localhost:5432/schema_flo
DATABASE_SSL=false

# Production/Neon example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# DATABASE_SSL=true

JWT_SECRET=replace-with-long-random-secret-min-32-chars
FRONTEND_URL=http://localhost:5173

# Email verification — Resend (облако) или Яндекс SMTP
RESEND_API_KEY=re_replace-with-resend-api-key
EMAIL_FROM=Schema Flo <noreply@your-domain.com>

# Яндекс Почта (smtp.yandex.ru) — пароль приложения из настроек Яндекс ID
YANDEX_SMTP_USER=your-login@yandex.ru
YANDEX_SMTP_PASS=your-app-password
# Альтернативные имена (любой SMTP):
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-login@yandex.ru
# SMTP_PASS=your-app-password

# CORS: через запятую, домены фронтенда
ALLOWED_ORIGINS=http://localhost:5173,https://schema-flo.vercel.app

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
