PORT=3001
NODE_ENV=development

# Local Docker/Postgres from docker-compose.yml:
DATABASE_URL=postgresql://schema_flo:schema_flo@localhost:5432/schema_flo
DATABASE_SSL=false

# Production/Neon example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# DATABASE_SSL=true

JWT_SECRET=replace-with-long-random-secret-min-32-chars
FRONTEND_URL=http://localhost:5173

# Email verification provider (Resend)
RESEND_API_KEY=re_replace-with-resend-api-key
EMAIL_FROM=Schema Flo <noreply@your-domain.com>

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
